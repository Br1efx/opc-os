{
  "name": "opc-core",
  "private": true,
  "version": "0.0.0",
    "description": "一人公司操作系统核心插件。含模块开关、设置、通知、文件面板笔记、画布、收集、卡片墙、任务工作流和界面优化。",
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "permissions.manifest.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "modules/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --import ../../scripts/verify/register-ts-import.mjs --test shared/*.test.mts server/*.test.mts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.43.0",
    "@opc-os/card-protocol": "workspace:*",
    "@opc-os/intake-core": "workspace:*",
    "@opc-os/page-fetch": "workspace:*",
    "@xyflow/react": "12.8.6",
    "defuddle": "0.19.6",
    "linkedom": "0.18.12",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
