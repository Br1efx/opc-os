{
  "name": "opc-os",
  "private": true,
  "version": "0.0.0",
  "description": "一人公司操作系统：装进 Paseo 的开源插件套装。当前含 D0 脚手架、D1 外壳和 D4 网关监控起步。",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && node --test \"scripts/verify/*.test.mjs\"",
    "verify": "node scripts/verify/run.mjs",
    "verify:boundary": "node scripts/verify/boundary.mjs",
    "verify:license": "node scripts/verify/license-scan.mjs",
    "verify:manifest": "node scripts/verify/manifest.mjs",
    "verify:perf": "node scripts/verify/perf-budget.mjs",
    "verify:mobile": "node scripts/verify/mobile.mjs"
  }
}
